# =============================================================================
# VIVADO 2025.2 GITIGNORE (PROJECT MODE + VITIS UNIFIED)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. VIVADO: TEMPORARY & JUNK FILES
# -----------------------------------------------------------------------------
*.jou
*.log
*.str
*.os
*.zip
*.tmp
*.backup.log
vivado_pid*.str
vivado_pid*.zip

# -----------------------------------------------------------------------------
# 2. VIVADO: MASSIVE INTERMEDIATE DIRECTORIES
# -----------------------------------------------------------------------------
# These are regenerated by Vivado automatically. Do not track.
.Xil/
*.cache/
*.hw/
*.runs/
*.sim/
*.ip_user_files/
*.gen/

# -----------------------------------------------------------------------------
# 3. VIVADO: BUILD ARTIFACTS
# -----------------------------------------------------------------------------
# We ignore bitstreams/checkpoints to keep the repo small. 
# Regenerate them from sources.
*.bit
*.bin
*.dcp
*.ltx

# -----------------------------------------------------------------------------
# 4. VITIS UNIFIED IDE (2025.2+)
# -----------------------------------------------------------------------------
# Ignore the disposable workspace wrapper
NetronV2/NetronV2WS_old/
vitis_workspace/
.metadata/
.ide/
.analytics/

# Ignore BUILD OUTPUTS inside your Component folders
# (This keeps your 'software' folder clean of object files and binaries)
*/build/
*/output/
*.elf
*.o
*.d
*.map

# Ignore Local User Settings in Vitis
.vitis/
.vscode/

# -----------------------------------------------------------------------------
# 5. WHITELIST (FORCE TRACK THESE FILES)
# -----------------------------------------------------------------------------

# --- Vivado Project Files ---
!*.xpr
!*.srcs/
!*.xdc
!*.tcl

# --- The Bridge (Hardware Export) ---
# CRITICAL: This allows Vitis to know about the FPGA hardware
!*.xsa

# --- Custom IP Repositories ---
!ip_repo/
!*.xci
!*.xcix
!component.xml

# --- Block Designs ---
!*.bd
!*.ui

# --- Vitis Component Definitions (2025.2) ---
# You MUST track these to restore the Vitis project
!vitis-comp.json
!CMakeLists.txt
!UserConfig.cmake

# --- Source Code ---
!*.c
!*.h
!*.cpp
!*.hpp
!*.ld
!lscript.ld